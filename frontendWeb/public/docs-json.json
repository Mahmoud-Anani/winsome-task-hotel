    "info": {
        "title": "Hotel Booking API",
        "description": "Hotel Booking Management System API",
        "version": "1.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "bearer": {
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "type": "http"
            }
        },
        "schemas": {
            "RegisterDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123",
                        "minLength": 6
                    },
                    "role": {
                        "type": "string",
                        "example": "HOTEL_MANAGER",
                        "enum": [
                            "ADMIN",
                            "HOTEL_MANAGER"
                        ]
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password",
                    "role"
                ]
            },
            "LoginDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "CreateHotelDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Grand Hotel"
                    },
                    "city": {
                        "type": "string",
                        "example": "New York"
                    },
                    "address": {
                        "type": "string",
                        "example": "123 Main St"
                    },
                    "stars": {
                        "type": "number",
                        "example": 5,
                        "minimum": 1,
                        "maximum": 5
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "INACTIVE"
                        ],
                        "default": "ACTIVE"
                    }
                },
                "required": [
                    "name",
                    "city",
                    "address",
                    "stars"
                ]
            },
            "UpdateHotelDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Grand Hotel"
                    },
                    "city": {
                        "type": "string",
                        "example": "New York"
                    },
                    "address": {
                        "type": "string",
                        "example": "123 Main St"
                    },
                    "stars": {
                        "type": "number",
                        "example": 5,
                        "minimum": 1,
                        "maximum": 5
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "INACTIVE"
                        ],
                        "default": "ACTIVE"
                    }
                }
            },
            "CreateRoomDto": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string",
                        "example": "hotel-uuid"
                    },
                    "roomType": {
                        "type": "string",
                        "example": "Deluxe Suite"
                    },
                    "capacity": {
                        "type": "number",
                        "example": 2
                    },
                    "pricePerNight": {
                        "type": "number",
                        "example": 150
                    },
                    "availableRoomsCount": {
                        "type": "number",
                        "example": 5
                    }
                },
                "required": [
                    "hotelId",
                    "roomType",
                    "capacity",
                    "pricePerNight",
                    "availableRoomsCount"
                ]
            },
            "UpdateRoomDto": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string",
                        "example": "hotel-uuid"
                    },
                    "roomType": {
                        "type": "string",
                        "example": "Deluxe Suite"
                    },
                    "capacity": {
                        "type": "number",
                        "example": 2
                    },
                    "pricePerNight": {
                        "type": "number",
                        "example": 150
                    },
                    "availableRoomsCount": {
                        "type": "number",
                        "example": 5
                    }
                }
            },
            "CreateBookingDto": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string",
                        "example": "hotel-uuid"
                    },
                    "roomId": {
                        "type": "string",
                        "example": "room-uuid"
                    },
                    "checkIn": {
                        "type": "string",
                        "example": "2024-12-01"
                    },
                    "checkOut": {
                        "type": "string",
                        "example": "2024-12-05"
                    },
                    "guestCount": {
                        "type": "number",
                        "example": 2
                    }
                },
                "required": [
                    "hotelId",
                    "roomId",
                    "checkIn",
                    "checkOut",
                    "guestCount"
                ]
            },
            "UpdateBookingStatusDto": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "PENDING",
                            "CONFIRMED",
                            "CANCELLED"
                        ]
                    }
                },
                "required": [
                    "status"
                ]
            }
        }
    }
